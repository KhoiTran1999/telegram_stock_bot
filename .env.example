# Chuyển sang "local" để dùng Polling
ENV_MODE=local

# Token bot Telegram của bạn
TELEGRAM_TOKEN="123456:ABC-DEF123456789"

# ID Telegram của bạn (để dùng lệnh admin)
ADMIN_ID="987654321"

# API Key cho LLM (báo cáo /report)
OPENROUTER_API_KEY="sk-or-v1-..."

# Chuỗi kết nối tới cơ sở dữ liệu
# Ví dụ cho Postgres chạy trên máy bạn:
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/stock_bot_db"

# PORT (không bắt buộc, 10000 là mặc định)
PORT=10000